{
  "name": "onco-io",
  "version": "0.1.0",
  "private": true,
  "description": "A multiplayer HTML5 browser game about developing anti-cancer products.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=80",
    "playtest:balance": "node server/playtest-runner.js",
    "playtest:verify": "node server/playtest-runner.js --verify",
    "test:unit": "node --test test/game.test.js test/map.test.js test/playtest.test.js",
    "test:integration": "node --test test/integration-lobby.test.js test/app.test.js test/economy-research.test.js test/logistics-contests.test.js test/automation-programmes.test.js test/interface.test.js test/balance-telemetry-replay.test.js test/playtest-runner.test.js",
    "test:unit:20": "LOBBY_SIZE=20 npm run test:unit",
    "test:unit:30": "LOBBY_SIZE=30 npm run test:unit",
    "test:unit:40": "LOBBY_SIZE=40 npm run test:unit",
    "test:integration:20": "LOBBY_SIZE=20 npm run test:integration",
    "test:integration:30": "LOBBY_SIZE=30 npm run test:integration",
    "test:integration:40": "LOBBY_SIZE=40 npm run test:integration",
    "test:unit:all": "npm run test:unit:20 && npm run test:unit:30 && npm run test:unit:40",
    "test:integration:all": "npm run test:integration:20 && npm run test:integration:30 && npm run test:integration:40",
    "test:browser": "node server/browser-runner.js",
    "test:load": "node server/load-runner.js",
    "release:gate": "node server/release-runner.js",
    "build": "node scripts/build-client.js",
    "benchmark:deltas": "node scripts/benchmark-deltas.js",
    "format:client": "prettier --write 'client/*.js' 'scripts/*.js'",
    "format:server": "prettier --write 'server/*.js'",
    "format": "prettier --write 'client/*.js' 'server/*.js' 'scripts/*.js'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6"
  }
}
